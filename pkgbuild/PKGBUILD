pkgname=trilha
pkgver=0.1.0
pkgrel=1
pkgdesc='Estudo de Infra & DevOps: apostila, glossário, flashcards, quiz e trilha'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/trilha "$pkgdir/usr/bin/trilha"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/../assets/trilha.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/trilha.svg"
  install -Dm644 "$startdir/trilha.desktop" "$pkgdir/usr/share/applications/trilha.desktop"
}
